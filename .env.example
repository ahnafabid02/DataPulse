# Local development only. Set a password and a matching URL before startup.
POSTGRES_DB=datapulse
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=
DATAPULSE_DATABASE_URL=postgresql+psycopg://datapulse:CHANGE_ME@127.0.0.1:5432/datapulse
DATAPULSE_LOG_LEVEL=INFO
# Local HTTP demo only. TLS deployments must use secure cookies.
DATAPULSE_BROWSER_ORIGIN=http://127.0.0.1:8000
DATAPULSE_COOKIE_SECURE=false
